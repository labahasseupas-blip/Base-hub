    createButton(trollPage, "👻 노클립 (Noclip) 토글", function()
        noclipEnabled = not noclipEnabled
    end)

    createButton(trollPage, "👥 모든 사람 내쪽으로 불러오기", function()
        local myChar = localPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
        local myPos = myChar.HumanoidRootPart.CFrame
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                p.Character.HumanoidRootPart.CFrame = myPos + Vector3.new(3, 0, 0)
            end
        end
    end)

    createButton(trollPage, "🌪️ 사람들 날리기 시스템", function()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local root = p.Character.HumanoidRootPart
                local bodyVel = Instance.new("BodyVelocity")
                bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bodyVel.Velocity = Vector3.new(math.random(-100, 100), 300, math.random(-100, 100))
                bodyVel.Parent = root
                task.delay(0.5, function()
                    if bodyVel then bodyVel:Destroy() end
                end)
            end
        end
    end)

    RunService.Stepped:Connect(function()
        if noclipEnabled and localPlayer.Character then
            for _, part in pairs(localPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
