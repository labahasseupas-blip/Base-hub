    local KeyBtnCorner = Instance.new("UICorner")
    KeyBtnCorner.CornerRadius = UDim.new(0, 6)
    KeyBtnCorner.Parent = KeyBtn

    local LinkBtn = Instance.new("TextButton")
    LinkBtn.Size = UDim2.new(0.85, 0, 0, 35)
    LinkBtn.Position = UDim2.new(0.075, 0, 0, 137)
    LinkBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242) -- 디스코드 색상
    LinkBtn.Text = "🔗 키 얻기 (디스코드 링크 복사)"
    LinkBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    LinkBtn.TextSize, LinkBtn.Font = 12, Enum.Font.GothamBold
    LinkBtn.Parent = KeyGui

    local LinkBtnCorner = Instance.new("UICorner")
    LinkBtnCorner.CornerRadius = UDim.new(0, 6)
    LinkBtnCorner.Parent = LinkBtn

    LinkBtn.MouseButton1Click:Connect(function()
        pcall(function()
            setclipboard("https://discord.gg/Z5pKmjrYzZ")
        end)
        LinkBtn.Text = "✅ 링크 복사 완료! (디코에서 확인)"
        task.wait(2)
        LinkBtn.Text = "🔗 키 얻기 (디스코드 링크 복사)"
    end)

    local authorized = false

    KeyBtn.MouseButton1Click:Connect(function()
        if KeyBox.Text == "base2026" then
            authorized = true
            KeyGui:Destroy()
        else
            KeyBox.Text = ""
            KeyBox.PlaceholderText = "틀렸습니다! 디코에서 키를 확인하세요"
            KeyBox.PlaceholderColor3 = Color3.fromRGB(255, 80, 80)
        end
    end)

    -- 키 인증될 때까지 대기
    repeat task.wait() until authorized

    -- ==========================================
    -- [로딩 화면 연출]
    -- ==========================================
    local LoadingFrame = Instance.new("Frame")
    LoadingFrame.Size = UDim2.new(0, 340, 0, 120)
    LoadingFrame.Position = UDim2.new(0.5, -170, 0.5, -60)
    LoadingFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    LoadingFrame.BorderSizePixel = 0
    LoadingFrame.Parent = ScreenGui

    local LoadCorner = Instance.new("UICorner")
    LoadCorner.CornerRadius = UDim.new(0, 10)
    LoadCorner.Parent = LoadingFrame

    local LoadStroke = Instance.new("UIStroke")
    LoadStroke.Color = Color3.fromRGB(45, 45, 65)
    LoadStroke.Thickness = 2
    LoadStroke.Parent = LoadingFrame

    local LoadText = Instance.new("TextLabel")
    LoadText.Size = UDim2.new(1, 0, 0, 50)
    LoadText.Position = UDim2.new(0, 0, 0, 15)
    LoadText.BackgroundTransparency = 1
    LoadText.Text = "⚡ 최고의 스크립트 허브 BASE HUB 로딩 중"
    LoadText.TextColor3 = Color3.fromRGB(255, 255, 255)
    LoadText.TextSize, LoadText.Font = 13, Enum.Font.GothamBold
    LoadText.Parent = LoadingFrame

    local SubLoadText = Instance.new("TextLabel")
    SubLoadText.Size = UDim2.new(1, 0, 0, 30)
    SubLoadText.Position = UDim2.new(0, 0, 0, 65)
    SubLoadText.BackgroundTransparency = 1
    SubLoadText.Text = "Made by Base"
    SubLoadText.TextColor3 = Color3.fromRGB(150, 150, 180)
    SubLoadText.TextSize, SubLoadText.Font = 12, Enum.Font.GothamMedium
    SubLoadText.Parent = LoadingFrame

    task.wait(1.5)
    LoadingFrame:Destroy()

    -- ==========================================
    -- [오른쪽 쉬프트 UI 토글 (부드러운 페이드)]
    -- ==========================================
    local isHidden = false
    local isAnimating = false

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.KeyCode == Enum.KeyCode.RightShift then
            if isAnimating then return end
            isAnimating = true
            isHidden = not isHidden

            local targetTrans = isHidden and 1 or 0
            local steps = 20
            local delayTime = 0.01

            for i = 1, steps do
                for _, child in pairs(ScreenGui:GetDescendants()) do
                    if child:IsA("Frame") or child:IsA("ScrollingFrame") then
                        child.BackgroundTransparency = child.BackgroundTransparency + ((targetTrans - child.BackgroundTransparency) * 0.25)
                    elseif child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("TextBox") then
                        child.BackgroundTransparency = child.BackgroundTransparency + ((targetTrans - child.BackgroundTransparency) * 0.25)
                        child.TextTransparency = child.TextTransparency + ((targetTrans - child.TextTransparency) * 0.25)
                    elseif child:IsA("UIStroke") then
                        child.Transparency = child.Transparency + ((targetTrans - child.Transparency) * 0.25)
                    end
                end
                task.wait(delayTime)
            end

            for _, child in pairs(ScreenGui:GetDescendants()) do
                if child:IsA("Frame") or child:IsA("ScrollingFrame") then
                    child.BackgroundTransparency = targetTrans
                elseif child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("TextBox") then
                    child.BackgroundTransparency = targetTrans
                    child.TextTransparency = targetTrans
                elseif child:IsA("UIStroke") then
                    child.Transparency = targetTrans
                end
            end

            UserInputService.MouseIconEnabled = true
            isAnimating = false
        end
    end)

    -- 메인 허브 생성
    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, 560, 0, 420)
    MainFrame.Position = UDim2.new(0.5, -280, 0.5, -210)
    MainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui

    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 10)
    MainCorner.Parent = MainFrame

    local MainStroke = Instance.new("UIStroke")
    MainStroke.Color = Color3.fromRGB(45, 45, 65)
    MainStroke.Thickness = 2
    MainStroke.Parent = MainFrame

    -- 상단 바
    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 38)
    TopBar.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    TopBar.BorderSizePixel = 0
    TopBar.Parent = MainFrame

    local TopCorner = Instance.new("UICorner")
    TopCorner.CornerRadius = UDim.new(0, 10)
    TopCorner.Parent = TopBar

    local dragging = false
    local dragInput, dragStart, startPos

    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local HubTitle = Instance.new("TextLabel")
    HubTitle.Size = UDim2.new(1, -20, 1, 0)
    HubTitle.Position = UDim2.new(0, 15, 0, 0)
    HubTitle.BackgroundTransparency = 1
    HubTitle.Text = "⚡ BASE HUB [add function!] ⚡"
    HubTitle.TextColor3 = Color3.fromRGB(200, 200, 220)
    HubTitle.TextSize, HubTitle.Font = 13, Enum.Font.GothamBold
    HubTitle.Parent = TopBar

    -- 카테고리 탭 버튼 영역
    local TabBar = Instance.new("Frame")
    TabBar.Size = UDim2.new(1, -20, 0, 36)
    TabBar.Position = UDim2.new(0, 10, 0, 46)
    TabBar.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    TabBar.Parent = MainFrame

    local TabCorner = Instance.new("UICorner")
    TabCorner.CornerRadius = UDim.new(0, 6)
    TabCorner.Parent = TabBar

    local TabLayout = Instance.new("UIListLayout")
    TabLayout.FillDirection = Enum.FillDirection.Horizontal
    TabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabLayout.Parent = TabBar

    -- 컨텐츠 컨테이너 생성 함수
    local pages = {}
    local function createCategory(name)
        local page = Instance.new("ScrollingFrame")
        page.Size = UDim2.new(1, -20, 1, -96)
        page.Position = UDim2.new(0, 10, 0, 88)
        page.BackgroundTransparency = 1
        page.CanvasSize = UDim2.new(0, 0, 0, 400)
        page.ScrollBarThickness = 4
        page.ScrollBarImageColor3 = Color3.fromRGB(60, 60, 80)
        page.Visible = false
        page.Parent = MainFrame

        local list = Instance.new("UIListLayout")
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.Padding = UDim.new(0, 8)
        list.Parent = page

        local tabBtn = Instance.new("TextButton")
        tabBtn.Size = UDim2.new(0.25, 0, 1, 0)
        tabBtn.BackgroundTransparency = 1
        tabBtn.Text = name
        tabBtn.TextColor3 = Color3.fromRGB(160, 160, 180)
        tabBtn.TextSize, tabBtn.Font = 12, Enum.Font.GothamBold
        tabBtn.Parent = TabBar

        tabBtn.MouseButton1Click:Connect(function()
            for _, p in pairs(pages) do p.Visible = false end
            page.Visible = true
        end)

        pages[name] = page
        return page
    end

    local function createButton(page, name, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 38)
        btn.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
        btn.Text = "  " .. name
        btn.TextColor3 = Color3.fromRGB(230, 230, 240)
        btn.TextSize, btn.Font = 13, Enum.Font.GothamSemibold
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = page

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = btn

        btn.MouseButton1Click:Connect(callback)
        return btn
    end

    -- ==========================================
    -- 1. 테마 카테고리
    -- ==========================================
    local themePage = createCategory("🎨 테마")
    themePage.Visible = true

    createButton(themePage, "🌈 하늘 무지개 테마 적용", function()
        local lighting = game:GetService("Lighting")
        lighting.Ambient = Color3.fromRGB(255, 100, 255)
        lighting.OutdoorAmbient = Color3.fromRGB(100, 200, 255)
        lighting.ClockTime = 12
        pcall(function()
            local sky = Instance.new("Sky")
            sky.SkyboxBk = "rbxassetid://60053075"
            sky.SkyboxDn = "rbxassetid://60053075"
            sky.SkyboxFt = "rbxassetid://60053075"
            sky.SkyboxLf = "rbxassetid://60053075"
            sky.SkyboxRt = "rbxassetid://60053075"
            sky.SkyboxUp = "rbxassetid://60053075"
            sky.Parent = lighting
        end)
    end)

    -- ==========================================
    -- 2. 공지 카테고리
    -- ==========================================
    local noticePage = createCategory("📢 공지")
    local NoticeBox = Instance.new("TextBox")
    NoticeBox.Size = UDim2.new(1, 0, 0, 80)
    NoticeBox.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    NoticeBox.Text = "📢 [공지] 디스코드 링크 버튼이랑 엄청난 기능들이 들어간 최신 BASE HUB 입니다!"
    NoticeBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    NoticeBox.TextSize, NoticeBox.Font = 12, Enum.Font.GothamMedium
    NoticeBox.TextWrapped = true
    NoticeBox.ClearTextOnFocus = false
    NoticeBox.Parent = noticePage

    local NoticeCorner = Instance.new("UICorner")
    NoticeCorner.CornerRadius = UDim.new(0, 6)
    NoticeCorner.Parent = NoticeBox

    -- ==========================================
    -- 3. 속도 카테고리 (카메라 기준 자유비행 Fly)
    -- ==========================================
    local speedPage = createCategory("⚡ 속도")

    local flying = false
    local flySpeed = 50
    local flyConnection
    local bv, bg

    local flyKeys = {
        W = false,
        A = false,
        S = false,
        D = false
    }

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.W then flyKeys.W = true
        elseif input.KeyCode == Enum.KeyCode.A then flyKeys.A = true
        elseif input.KeyCode == Enum.KeyCode.S then flyKeys.S = true
        elseif input.KeyCode == Enum.KeyCode.D then flyKeys.D = true end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.W then flyKeys.W = false
        elseif input.KeyCode == Enum.KeyCode.A then flyKeys.A = false
        elseif input.KeyCode == Enum.KeyCode.S then flyKeys.S = false
        elseif input.KeyCode == Enum.KeyCode.D then flyKeys.D = false end
    end)

    createButton(speedPage, "✈️ 자유비행 (Fly) 토글", function()
        flying = not flying
        local character = localPlayer.Character
        if not character then return end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChild("Humanoid")
        if not rootPart or not humanoid then return end

        if flying then
            humanoid.PlatformStand = true
            if rootPart:FindFirstChild("BaseFlyVel") then rootPart.BaseFlyVel:Destroy() end
            if rootPart:FindFirstChild("BaseFlyGyro") then rootPart.BaseFlyGyro:Destroy() end

            bv = Instance.new("BodyVelocity")
            bv.Name = "BaseFlyVel"
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = rootPart

            bg = Instance.new("BodyGyro")
            bg.Name = "BaseFlyGyro"
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.P = 30000
            bg.CFrame = rootPart.CFrame
            bg.Parent = rootPart

            if flyConnection then flyConnection:Disconnect() end
            flyConnection = RunService.RenderStepped:Connect(function()
                if not flying or not character or not rootPart or not humanoid or humanoid.Health <= 0 then
                    if flyConnection then
                        flyConnection:Disconnect()
                        flyConnection = nil
                    end
                    return
                end

                local cam = workspace.CurrentCamera
                local forward = cam.CFrame.LookVector
                local right = cam.CFrame.RightVector
                local direction = Vector3.zero

                if flyKeys.W then direction += forward end
                if flyKeys.S then direction -= forward end
                if flyKeys.A then direction -= right end
                if flyKeys.D then direction += right end

                if direction.Magnitude > 0 then
                    direction = direction.Unit
                    bv.Velocity = direction * flySpeed
                else
                    bv.Velocity = Vector3.zero
                end

                bg.CFrame = cam.CFrame
            end)
        else
            humanoid.PlatformStand = false
            if flyConnection then
                flyConnection:Disconnect()
                flyConnection = nil
            end
            if rootPart:FindFirstChild("BaseFlyVel") then rootPart.BaseFlyVel:Destroy() end
            if rootPart:FindFirstChild("BaseFlyGyro") then rootPart.BaseFlyGyro:Destroy() end
        end
    end)

    createButton(speedPage, "⚡ 이동 속도 2000 설정", function()
        local character = localPlayer.Character
        if character and character:FindFirstChild("Humanoid") then
            character.Humanoid.WalkSpeed = 2000
        end
    end)

    -- ==========================================
    -- 4. 트롤 카테고리
    -- ==========================================
    local trollPage = createCategory("💥 트롤")

    createButton(trollPage, "🎒 툴 다 가져오기 (Tool Grabber)", function()
        local character = localPlayer.Character
        if not character then return end
        for _, item in pairs(workspace:GetDescendants()) do
            if item:IsA("Tool") then
                local clone = item:Clone()
                clone.Parent = localPlayer.Backpack
            end
        end
    end)

    local deleteToolActive = false
    createButton(trollPage, "💥 클릭 파츠 삭제 툴", function()
        deleteToolActive = not deleteToolActive
        if deleteToolActive then
            local tool = Instance.new("Tool")
            tool.RequiresHandle = false
            tool.Name = "삭제 툴 (Delete Tool)"
            tool.Activated:Connect(function()
                local target = Mouse.Target
                if target then
                    target:Destroy()
                end
            end)
            tool.Parent = localPlayer.Backpack
        end
    end)

    local noclipEnabled = false
    createButton(trollPage, "👻 노클립 (Noclip) 토글", function()
        noclipEnabled = not noclipEnabled
    end)

    RunService.Stepped:Connect(function()
        if noclipEnabled and localPlayer.Character then
            for _, part in pairs(localPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end)
